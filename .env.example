# ── Configuración del timbre digital ────────────────────────────
VITE_TITLE=Mi Edificio 123

# Tamaño de la grilla
VITE_FLOORS=8
VITE_APTS_PER_FLOOR=3
# Departamentos del último piso (opcional, por defecto VITE_APTS_PER_FLOOR)
VITE_TOP_FLOOR_APTS=1

# Mensaje que se envía al tocar un botón. {APARTMENT} se reemplaza, ej. "8A".
VITE_DEFAULT_MESSAGE=¡Hola! Estoy en la puerta del departamento {APARTMENT}. ¿Me abrís, por favor?

# Teléfonos: una clave por departamento, VITE_PHONE_<piso><letra>.
# Formato internacional, solo números — sin + ni espacios (ej. 5493411234567).
# Si una clave falta o está vacía → el departamento se muestra en gris.
VITE_PHONE_1A=5493331112233
VITE_PHONE_1B=5493331112233
VITE_PHONE_1C=5493331112233
VITE_PHONE_2A=5493331112233
VITE_PHONE_2B=5493331112233
VITE_PHONE_2C=5493331112233
VITE_PHONE_3A=5493331112233
VITE_PHONE_3B=5493331112233
VITE_PHONE_3C=5493331112233
VITE_PHONE_4A=5493331112233
VITE_PHONE_4B=5493331112233
VITE_PHONE_4C=5493331112233
VITE_PHONE_5A=5493331112233
VITE_PHONE_5B=5493331112233
VITE_PHONE_5C=5493331112233
